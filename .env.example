# QuickLoan environment configuration.
# Copy to .env and adjust. Never commit real secrets.

PORT=4000
APP_URL=http://localhost:5173
NODE_ENV=development
DATABASE_PATH=./data/quickloan.db

# Session secret — MUST be a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# Demo mode: seeds demo data on first start, shows demo credentials on the entry screen,
# enables demo tools (reset data, advance clock). Always disabled when NODE_ENV=production.
DEMO_MODE=true

# Maximum loan period (days). V1 product rule is 30; configurable for future expansion.
MAX_LOAN_PERIOD_DAYS=30

# ---- Embedded CRB (the company's existing CRB). Blank URL/key => simulated results in demo mode ----
CRB_NAME=Wakandi CRB
CRB_API_URL=
CRB_API_KEY=

# ---- Payments (M-PESA Daraja). Blank => mock provider ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_CALLBACK_BASE_URL=

# ---- Jami SMS. Blank => mock provider ----
JAMI_API_URL=
JAMI_API_KEY=
JAMI_SENDER_ID=QUICKLOAN
SMS_COST_PER_SEGMENT_CENTS=80

# ---- Wakandi message service (as used by Wakandi Jamii). Blank => Jami / mock ----
MESSAGE_SERVICE_URL=
MESSAGE_SERVICE_SSO_URL=
MESSAGE_SERVICE_CLIENT_ID=
MESSAGE_SERVICE_CLIENT_SECRET=
MESSAGE_SERVICE_APP_NAME=quickloan

# ---- Integrations awaiting API documentation. Blank => mock (demo) ----
# Core banking: loan accounts, ledger, balances (COMS)
COMS_API_URL=
COMS_API_KEY=
# Wakandi Pay: disbursement and repayment rails (select with PAYMENT_PROVIDER=wakandipay)
WAKANDI_PAY_API_URL=
WAKANDI_PAY_API_KEY=
# mock | mpesa | wakandipay (blank => mpesa when configured, else mock)
PAYMENT_PROVIDER=
# Identity verification for the Member Quality Check
IDENTITY_API_URL=
IDENTITY_API_KEY=
# Push notifications
PUSH_API_URL=
PUSH_API_KEY=
